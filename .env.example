# ==============================================================================
# COMIC WEEK — ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Connection String (Neon.tech Serverless Postgres)
# Ambil dari Neon Console (Dashboard -> Project -> Connection details)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication Session Secret
# Kunci rahasia 256-bit (64 karakter hex) yang dihasilkan secara kriptografis
ADMIN_SECRET="c97d2bfc430f7fe26d02c49d9758aae5b958a586c04ababd01f516b0a000b934"

# Cloudflare R2 Storage (S3-Compatible API)
# Digunakan untuk upload gambar komik langsung via Presigned PUT URL (bypass limit 4.5 MB Vercel)
# Cache-Control diset otomatis: public, max-age=31536000, immutable
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="komikweeks"
# Domain publik bucket R2 (misal dari Public R2.dev bucket URL atau custom domain seperti https://cdn.komikweeks.com)
R2_PUBLIC_DOMAIN="https://pub-your_r2_subdomain.r2.dev"

# Akun admin default saat menjalankan seeding database (npm run db:seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="comicweek123"
